{
  "name": "@zimlo/adapters",
  "version": "0.2.1",
  "description": "Codex and Claude Code discovery adapters for Zimlo",
  "license": "MIT",
  "files": ["dist"],
  "engines": { "node": ">=24.0.0" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zimlo/protocol": "workspace:*",
    "fast-glob": "^3.3.3"
  }
}
