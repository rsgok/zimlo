{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zimlo-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "ratelimits": [
    {
      "name": "REGISTRATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zimlo-cloud",
      "database_id": "f28f29e1-524e-4958-87c0-840d9f0abe5d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "zimlo-releases"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOMS",
        "class_name": "RelayRoom"
      },
      {
        "name": "PAIRING_ROOMS",
        "class_name": "PairingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PairingRoom"]
    }
  ]
}
